# Django Settings
PROJECT_NAME=DevBrInvoices
# Generate a new random secret key for your production environment
SECRET_KEY=replace-me-with-a-secure-random-secret-key
# Used for encrypting sensitive data
ENCRYPTION_KEY=replace-me-with-a-secure-random-encryption-key

# Set to False in production!
DEBUG=True

# Comma-separated list of allowed hosts (e.g. yourdomain.com,www.yourdomain.com)
ALLOWED_HOSTS=*

# Database Configuration (PostgreSQL)
POSTGRES_DB=notas
POSTGRES_USER=notas
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email Configuration (Google Workspace / SMTP)
# Change the backend to smtp to actually send emails instead of printing to console
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=your-email@yourdomain.com

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
